# Committed rather than generated, because two of its lines are not the
# defaults and finding that out costs a build on a machine this project does
# not have: the deployment target has to be 15, which is ML Kit's minimum and
# above Flutter's, and `use_frameworks!` is what a Swift pod needs.
#
# Never run. There is no macOS here; the first `pod install` will be CI's.
platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously, which slows the build.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  # So the Runner's test target can link the plugin and test the landmark
  # arithmetic, which is the one piece of native code in this project that
  # anything automated has ever executed.
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      # ML Kit ships no arm64 simulator slice, so an Apple Silicon Mac
      # cannot run this app in a simulator at all. Builds and tests go to a
      # device, or to a device-destination build without signing.
      config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = 'arm64 i386'

      # So RunnerTests can reach into the plugin with @testable rather than
      # the plugin having to make its landmark arithmetic public to be
      # tested at all.
      config.build_settings['ENABLE_TESTABILITY'] = 'YES' if config.name == 'Debug'
    end
  end
end
